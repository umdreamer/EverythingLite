# Isolated Ubuntu compiler/test environment; production data is never mounted.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake libsqlite3-dev ca-certificates \
    qt6-base-dev qt6-base-dev-tools libgl1-mesa-dev \
    dbus xvfb xauth xdg-utils file dpkg-dev \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get -o Acquire::Retries=3 update \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && (for attempt in 1 2 3; do \
        DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends qt6-wayland weston \
            && exit 0; \
        done; exit 1) \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
# The Qt development tools install Python; require it for CLI parity checks.
RUN python3 --version
ENV LANG=C.UTF-8
WORKDIR /src
CMD ["bash"]
